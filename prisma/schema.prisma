generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id
  name                 String
  email                String            @unique
  emailVerified        Boolean           @default(false)
  image                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  sessions             Session[]
  accounts             Account[]
  workspaceMemberships WorkspaceMember[]
  auditLogs            AuditLog[]

  @@map("user")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  hostels            Hostel[]
  residents          Resident[]
  invites            WorkspaceInvite[]
  leadApplications   LeadApplication[]
  maintenanceTickets MaintenanceTicket[]
  qualityEntries     QualityEntry[]
  internalRequests   InternalRequest[]
  auditLogs          AuditLog[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(ADMIN)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  STAFF
}

model WorkspaceInvite {
  id              String        @id @default(cuid())
  workspaceId     String
  email           String
  invitedByUserId String
  role            WorkspaceRole @default(ADMIN)
  createdAt       DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Hostel {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rooms              Room[]
  leadApplications   LeadApplication[]
  maintenanceTickets MaintenanceTicket[]
  qualityEntries     QualityEntry[]
  internalRequests   InternalRequest[]

  @@index([workspaceId])
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String
  floor     Int?
  hostelId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostel             Hostel              @relation(fields: [hostelId], references: [id])
  beds               Bed[]
  maintenanceTickets MaintenanceTicket[]
  qualityEntries     QualityEntry[]
  internalRequests   InternalRequest[]
}

model Bed {
  id         Int      @id @default(autoincrement())
  number     Int
  roomId     Int
  notes      String?
  isDisabled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room     Room      @relation(fields: [roomId], references: [id])
  resident Resident?
  stays    Stay[]

  @@unique([roomId, number])
}

model Resident {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String?
  email     String?
  notes     String?
  checkIn   DateTime
  checkOut  DateTime?
  birthDate DateTime?
  gender    Gender?

  // Нові поля
  isActive   Boolean   @default(true)
  archivedAt DateTime?

  // Ліжко тепер необов'язкове
  bedId Int? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspaceId String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bed         Bed?      @relation(fields: [bedId], references: [id])
  payments    Payment[]
  stays       Stay[]
  paidThrough DateTime?

  @@index([workspaceId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Stay {
  id         Int       @id @default(autoincrement())
  residentId Int
  bedId      Int
  startedAt  DateTime
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  bed      Bed      @relation(fields: [bedId], references: [id])

  @@index([residentId, startedAt])
  @@index([bedId, startedAt])
}

model Payment {
  id          Int           @id @default(autoincrement())
  amount      Decimal
  paid        Boolean       @default(false)
  dueDate     DateTime
  paidAt      DateTime?
  notes       String?
  type        PaymentType   @default(RENT)
  method      PaymentMethod @default(CASH)
  paidThrough DateTime?
  residentId  Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  resident Resident @relation(fields: [residentId], references: [id])

  @@index([residentId, dueDate])
  @@index([paid, dueDate])
}

enum PaymentType {
  RENT
  DEPOSIT
  OTHER
}

enum PaymentMethod {
  CASH
  BLIK
  BANK_TRANSFER
  CARD
  COMPANY
  OTHER
}

model LeadApplication {
  id            Int        @id @default(autoincrement())
  workspaceId   String
  hostelId      Int?
  fullName      String
  phone         String
  email         String?
  peopleCount   Int        @default(1)
  desiredMoveIn DateTime?
  stayMonths    Int?
  budget        Decimal?
  source        String     @default("MANUAL")
  externalId    String?
  status        LeadStatus @default(NEW)
  notes         String?
  assignedTo    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostel    Hostel?   @relation(fields: [hostelId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([hostelId])
  @@index([source, externalId])
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING
  CONFIRMED
  MOVED_IN
  REJECTED
}

model MaintenanceTicket {
  id            Int            @id @default(autoincrement())
  workspaceId   String
  hostelId      Int
  roomId        Int?
  category      String
  description   String
  photoUrl      String?
  priority      TicketPriority @default(NORMAL)
  status        TicketStatus   @default(NEW)
  reporterName  String?
  reporterPhone String?
  assignedTo    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostel    Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([hostelId, roomId])
}

enum TicketPriority {
  LOW
  NORMAL
  URGENT
}

enum TicketStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  DONE
}

model QualityEntry {
  id          Int           @id @default(autoincrement())
  workspaceId String
  hostelId    Int?
  roomId      Int?
  source      String        @default("INTERNAL")
  authorName  String?
  rating      Int?
  category    String
  text        String
  status      QualityStatus @default(NEW)
  assignedTo  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostel    Hostel?   @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([hostelId, roomId])
}

enum QualityStatus {
  NEW
  REVIEWED
  RESOLVED
}

model InternalRequest {
  id                Int                     @id @default(autoincrement())
  workspaceId       String
  hostelId          Int?
  roomId            Int?
  requestedByUserId String
  assignedToUserId  String?
  approvedByUserId  String?
  category          InternalRequestCategory
  title             String
  description       String
  amount            Decimal?
  attachmentUrl     String?
  priority          TicketPriority          @default(NORMAL)
  status            InternalRequestStatus   @default(NEW)
  dueDate           DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  completedAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hostel    Hostel?   @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  room      Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([requestedByUserId, createdAt])
  @@index([assignedToUserId, status])
}

enum InternalRequestCategory {
  PURCHASE
  CLEANING
  LINEN
  REPAIR
  TRANSPORT
  BILL
  HR
  OTHER
}

enum InternalRequestStatus {
  NEW
  REVIEW
  APPROVED
  IN_PROGRESS
  DONE
  REJECTED
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  workspaceId String
  actorUserId String?
  actorName   String
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
